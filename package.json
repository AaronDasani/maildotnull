{
  "name": "maildotnull",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": "github:maildotnull/maildotnull",
  "homepage": "https://github.com/maildotnull/maildotnull",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.4",
    "hono": "^4.8.0",
    "mailparser": "^3.9.14",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@fontsource-variable/geist": "^5.2.5",
    "@fontsource-variable/geist-mono": "^5.2.5",
    "@tailwindcss/vite": "^4",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^5",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.0",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^6",
    "lucide-react": "^1.24.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "vite": "^7"
  },
  "packageManager": "pnpm@10.30.0"
}
