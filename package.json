{
  "name": "maildotnull",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": "github:maildotnull/maildotnull",
  "homepage": "https://github.com/maildotnull/maildotnull",
  "scripts": {
    "dev": "vite",
    "build": "vite build && esbuild src/server/index.ts --bundle --platform=node --format=esm --packages=external --outdir=dist/server",
    "start": "node dist/server/index.js",
    "clean": "rm -rf dist",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run build"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.8",
    "hono": "^4.12.30",
    "mailparser": "^3.9.14",
    "selfsigned": "^5.5.0",
    "smtp-server": "^3.19.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@tailwindcss/vite": "^4.3.2",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/smtp-server": "^3.5.13",
    "@vitejs/plugin-react": "^6.0.3",
    "clsx": "^2.1.1",
    "esbuild": "^0.28.1",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "lucide-react": "^1.24.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.4"
  },
  "packageManager": "pnpm@10.30.0"
}
